DATABASE_URL=
OPENALEX_API_KEY=
OPENALEX_MAILTO=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
REPORT_TO=

# Team mode (enable only after a shared PostgreSQL database and initial admin exist)
TEAM_AUTH_ENABLED=false


# Business Workspace Agent MCP (all external access disabled by default)
# Set real values only in the Render environment dashboard; never commit secrets.
BUSINESS_MCP_ENABLED=false
BUSINESS_AGENT_SHARING_APPROVED=false
BUSINESS_MCP_RESOURCE_URL=https://research-atlas-api-test.onrender.com/research-advisor/mcp
BUSINESS_MCP_ISSUER_URL=https://<supabase-project-ref>.supabase.co/auth/v1
BUSINESS_MCP_JWKS_URL=https://<supabase-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
BUSINESS_MCP_ALLOWED_SUBJECTS=
BUSINESS_MCP_ALLOWED_CLIENT_IDS=

# Independent permissions: start with all three disabled.
BUSINESS_MCP_WRITE_ENABLED=false
BUSINESS_MCP_ALLOWED_WRITE_CLIENT_IDS=
BUSINESS_MCP_EXECUTION_ENABLED=false
BUSINESS_MCP_ALLOWED_EXECUTION_CLIENT_IDS=

# Public-only Supabase OAuth consent page configuration.
OAUTH_CONSENT_ENABLED=false
OAUTH_CONSENT_SUPABASE_URL=
OAUTH_CONSENT_PUBLISHABLE_KEY=
