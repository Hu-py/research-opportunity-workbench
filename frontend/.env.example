# For local development; use Vercel environment variables for cloud deployment.
BACKEND_URL=http://127.0.0.1:8000
API_BEARER_TOKEN=replace-with-matching-backend-token
APP_PASSWORD=replace-with-private-login-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Team mode: enable after backend admin bootstrap; no APP_PASSWORD login in this mode
TEAM_AUTH_ENABLED=false


# Separate Research Agent Lab Supabase project; SERVER ONLY (Next.js route handlers).
# Do not prefix either name with NEXT_PUBLIC_. They are NOT browser-side variables.
RESEARCH_LAB_SUPABASE_URL=https://YOUR-ISOLATED-PROJECT.supabase.co
RESEARCH_LAB_SUPABASE_SECRET_KEY=sb_secret_YOUR_PRIVATE_SERVER_KEY


# Launch Research Agent Lab via GitHub Actions (SERVER-ONLY).
# Fine-grained PAT restricted to Hu-py/research-agent-lab, Actions: Read and write.
# NEVER use NEXT_PUBLIC_ prefix. Only team admins may dispatch runs.
RESEARCH_LAB_GITHUB_TOKEN=github_pat_YOUR_REPO_SCOPED_ACTIONS_TOKEN
