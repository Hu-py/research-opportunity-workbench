FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY pyproject.toml ./
COPY research_workbench ./research_workbench
COPY backend ./backend
COPY skills ./skills
COPY scripts ./scripts
RUN pip install --no-cache-dir '.[postgres,ai]'
RUN useradd --create-home --uid 10001 researcher
USER researcher
EXPOSE 8000
CMD ["sh","-c","python -m scripts.devstudio_postgres_e2e && exec uvicorn backend.api:app --host 0.0.0.0 --port 8000"]
