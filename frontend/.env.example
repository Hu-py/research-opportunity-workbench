# For local development; use Vercel environment variables for cloud deployment.
BACKEND_URL=http://127.0.0.1:8000
API_BEARER_TOKEN=replace-with-matching-backend-token
APP_PASSWORD=replace-with-private-login-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Team mode: enable after backend admin bootstrap; no APP_PASSWORD login in this mode
TEAM_AUTH_ENABLED=false
